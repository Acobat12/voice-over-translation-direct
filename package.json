{
  "name": "voice-over-translation",
  "version": "1.0.0",
  "author": "Toil",
  "license": "MIT",
  "description": "A small extension that adds a Yandex Browser video translation to other browsers",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Acobat12/voice-over-translation-direct.git"
  },
  "keywords": [
    "cli",
    "vot",
    "voice-over-translation-direct"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@toil/typebox-genx": "^0.1.0",
    "@types/bun": "1.3.14",
    "@vot.js/core": "^2.4.12",
    "crx3": "^2.0.0",
    "lefthook": "^2.1.9",
    "lightningcss": "^1.32.0",
    "npm-run-all2": "^9.0.2",
    "sass": "^1.97.3",
    "typescript": "5.9.3",
    "vite": "8.1.3",
    "vite-plugin-monkey": "8.0.6",
    "zip-a-folder": "6.1.2"
  },
  "scripts": {
    "test": "bun test",
    "test:unit": "bun test",
    "test:unit:watch": "bun test --watch",
    "test:ui": "vite build --config vite.test-ui.config.ts",
    "repair:vot-node-modules": "node ./scripts/repair-vot-node-modules.mjs",
    "build": "vite build --config vite.config.ts",
    "build:min": "vite build --mode minify --config vite.config.ts",
    "build:all": "npx run-p build build:min",
    "build:ext": "vite build --config vite.extension.config.ts",
    "build:chrome": "vite build --mode chrome --config vite.extension.config.ts",
    "build:chrome:diag": "vite build --mode chrome-diag --config vite.extension.config.ts",
    "build:firefox": "vite build --mode firefox --config vite.extension.config.ts",
    "build:firefox:diag": "vite build --mode firefox-diag --config vite.extension.config.ts",
    "build:dev": "vite build --mode development --config vite.config.ts",
    "build:diag": "vite build --mode diagnostic --config vite.config.ts",
    "dev": "vite dev",
    "format": "bunx @biomejs/biome check --write --unsafe ./src",
    "gen:wiki": "bun run ./scripts/wiki-gen/index.js",
    "localize": "bunx \"@toil/localize-tui\"",
    "build:safari": "vite build --config vite.safari-userscript.config.ts",
    "build:safari:diag": "vite build --mode diagnostic --config vite.safari-userscript.config.ts",
    "build:safari:main": "vite build --config vite.safari-userscript.config.ts",
    "build:safari:main:diag": "vite build --mode diagnostic --config vite.safari-userscript.config.ts",
    "build:safari:page": "vite build --config vite.safari-userscript.config.ts",
    "build:safari:page:diag": "vite build --mode diagnostic --config vite.safari-userscript.config.ts"
  },
  "dependencies": {
    "@toil/gm-types": "1.0.4",
    "@vot.js/ext": "2.4.18",
    "@vot.js/shared": "2.4.18",
    "bowser": "2.14.1",
    "chaimu": "1.0.6",
    "googlevideo": "^4.1.1",
    "lit-html": "3.3.3"
  },
  "bun": {
    "patchedDependencies": {
      "chaimu@1.0.6": "patches/chaimu@1.0.6.patch"
    }
  }
}
